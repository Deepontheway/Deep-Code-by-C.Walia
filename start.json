{
  "daemon": true,
  "run": [
    {
      "method": "shell.run",
      "params": {
        "message": "Starting Deep Code by C. Walia",
        "path": "{{self}}",
        "venv": "venv",
        "command": "python -m uvicorn walia.main:app --app-dir app --host 127.0.0.1 --port 8765 --no-access-log",
        "env": { "WALIACODE_HOME": "{{self}}/data" },
        "on": [
          { "event": "Uvicorn running on http://127\\.0\\.0\\.1:8765", "done": true }
        ]
      }
    },
    {
      "method": "local.set",
      "params": { "url": "http://127.0.0.1:8765" }
    }
  ]
}
