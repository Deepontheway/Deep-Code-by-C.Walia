{
  "run": [
    {
      "method": "shell.run",
      "params": {
        "message": "Installing dependencies...",
        "path": "{{self}}",
        "command": "npm install"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "Pulling qwen3-coder:14b via Ollama (if available)...",
        "path": "{{self}}",
        "command": "ollama pull qwen3-coder:14b 2>&1 || echo 'Ollama not found, will use Big Pickle'"
      }
    }
  ]
}
