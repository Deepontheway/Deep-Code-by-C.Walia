{
  "run": [
    {
      "method": "shell.run",
      "params": {
        "message": "Installing Node dependencies",
        "path": "{{self}}",
        "command": "npm install --legacy-peer-deps"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "Installing system dependencies (winget)",
        "path": "{{self}}",
        "command": "node scripts/install-deps.js 2>&1 || echo done"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "Pulling qwen3-coder:14b",
        "path": "{{self}}",
        "command": "ollama pull qwen3-coder:14b 2>&1 || echo 'Ollama not ready yet'"
      }
    }
  ]
}
