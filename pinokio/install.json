{
  "run": [
    {
      "method": "shell.run",
      "params": {
        "message": "Installing all dependencies",
        "path": "{{self}}",
        "command": "npm install --legacy-peer-deps"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "Running dependency setup",
        "path": "{{self}}",
        "command": "node scripts/install-deps.js 2>&1 || echo 'Setup completed'"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "Downloading recommended models",
        "path": "{{self}}",
        "command": "ollama pull qwen3-coder:14b 2>&1; ollama pull deepseek-coder-v2 2>&1; ollama pull qwen2.5-coder:14b 2>&1 || echo 'Models will download on first use'"
      }
    }
  ]
}
